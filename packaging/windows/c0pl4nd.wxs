<?xml version="1.0" encoding="utf-8"?>
<!--
  C0PL4ND Windows installer. WiX Toolset v6 (dotnet "wix" CLI).
  The release.yml "msi" job builds this; see that workflow for the exact
  invocation (it installs the wix global tool, adds the WixToolset.UI.wixext
  extension, builds the release binary, then runs "wix build" from the repo
  root). Source paths below are relative to the working directory (repo root).
  The UpgradeCode GUID is STABLE: never regenerate it, or upgrades will break.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="C0PL4ND"
    Manufacturer="Itasha.Corp"
    Version="$(var.Version)"
    UpgradeCode="ADBB978D-ED4E-4EE3-A04F-22293BB12275"
    Language="1033"
    Codepage="1252"
    Scope="perMachine">

    <SummaryInformation
      Keywords="terminal,emulator,gpu,rust"
      Description="C0PL4ND — the operator's shell into the wired" />

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of C0PL4ND is already installed. Setup will now exit." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Install under Program Files\C0PL4ND and add it to the machine PATH. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="C0PL4ND">
        <Component Id="MainExecutable" Guid="*">
          <File
            Id="c0pl4ndExe"
            Name="c0pl4nd.exe"
            Source="target\release\c0pl4nd.exe"
            KeyPath="yes" />
          <Environment
            Id="UpdatePath"
            Name="PATH"
            Value="[INSTALLFOLDER]"
            Permanent="no"
            Part="last"
            Action="set"
            System="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Start Menu shortcut. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="C0PL4ND">
        <Component Id="ApplicationShortcut" Guid="*">
          <!--
            The AUMID is REQUIRED, not decoration.

            A non-packaged Win32 process may only raise a WinRT toast under an
            Application User Model ID that resolves to an installed Start-Menu
            shortcut carrying that same ID in its System.AppUserModel.ID
            property. With no such property, ToastNotifier.Show() RETURNS
            SUCCESS and nothing is ever displayed - the failure has no runtime
            symptom at all. C0PL4ND's OSC 9 / OSC 777 desktop-notification
            path raises such a toast, so without this line that whole
            feature is silently inert on a machine installed from this MSI.

            The value MUST equal notify::AUMID in crates/app/src/notify.rs.
            The pair is pinned in both directions by the notify_tests aumid
            tests, which parse this file - a hand edit here that disagrees with
            the constant fails the build rather than shipping a dead toast.

            The shortcut is deliberately NON-advertised (a plain Target=), which
            is what lets it carry shell properties.
          -->
          <Shortcut
            Id="ApplicationStartMenuShortcut"
            Name="C0PL4ND"
            Description="C0PL4ND terminal emulator"
            Target="[INSTALLFOLDER]c0pl4nd.exe"
            WorkingDirectory="INSTALLFOLDER">
            <ShortcutProperty Key="System.AppUserModel.ID" Value="Itasha.Corp.C0PL4ND" />
          </Shortcut>
          <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
          <RegistryValue
            Root="HKCU"
            Key="Software\Itasha.Corp\C0PL4ND"
            Name="installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!--
      Explorer context-menu verb: "Open C0PL4ND here".

      Two keys are required, and they are NOT interchangeable:
        * Directory\shell          - right-click ON a folder icon.
        * Directory\Background\shell - right-click on the EMPTY SPACE inside an
          open folder (the far more common gesture).

      Both use the %V token. %V is correct for BOTH cases; %1 works only for the
      first and expands to nothing for Background, which is the classic bug that
      makes the verb silently open in the wrong directory. The value is passed to
      the binary's cwd flag (see crates/app/src/cli_cwd.rs), which validates it
      and refuses a non-existent or non-directory path rather than falling back
      silently - a path arriving from the shell is untrusted input.

      ForceDeleteOnUninstall removes the whole key on uninstall so no orphan verb
      is left pointing at a deleted binary.
    -->
    <Component Id="ShellOpenHereVerb" Guid="*" Directory="INSTALLFOLDER">
      <RegistryKey
        Root="HKLM"
        Key="Software\Classes\Directory\shell\C0pl4ndOpenHere"
        ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="Open C0PL4ND here" KeyPath="yes" />
        <RegistryValue Name="Icon" Type="string" Value="[INSTALLFOLDER]c0pl4nd.exe" />
      </RegistryKey>
      <RegistryKey
        Root="HKLM"
        Key="Software\Classes\Directory\shell\C0pl4ndOpenHere\command"
        ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]c0pl4nd.exe&quot; --cwd &quot;%V&quot;" />
      </RegistryKey>

      <RegistryKey
        Root="HKLM"
        Key="Software\Classes\Directory\Background\shell\C0pl4ndOpenHere"
        ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="Open C0PL4ND here" />
        <RegistryValue Name="Icon" Type="string" Value="[INSTALLFOLDER]c0pl4nd.exe" />
      </RegistryKey>
      <RegistryKey
        Root="HKLM"
        Key="Software\Classes\Directory\Background\shell\C0pl4ndOpenHere\command"
        ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]c0pl4nd.exe&quot; --cwd &quot;%V&quot;" />
      </RegistryKey>
    </Component>

    <Feature Id="Main" Title="C0PL4ND" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="ShellOpenHereVerb" />
    </Feature>

    <!-- Add/Remove Programs metadata + branded icon. -->
    <Icon Id="ProductIcon" SourceFile="packaging\windows\c0pl4nd.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/itasha-corp/c0pl4nd" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/itasha-corp/c0pl4nd" />

    <!-- Install-dir UI with the MIT OR Apache-2.0 license shown to the user. -->
    <WixVariable Id="WixUILicenseRtf" Value="packaging\windows\License.rtf" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />
  </Package>
</Wix>
