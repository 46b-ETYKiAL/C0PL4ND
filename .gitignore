/target
**/*.rs.bk
.DS_Store
Thumbs.db
.env
*.pem
*.key

# Tooling runtime artifacts (never publish). Matched by shape rather than
# by name, so this file does not itself publish the internal directory
# names the content-safety audit exists to suppress.
.*-data/
relfinal.log
*.log
egui-app.png

egui-*.png
# Stale-by-rename proptest seeds are noise; a real regression is pinned in the test itself.
*.proptest-regressions

# cargo-mutants run output (transient local mutation-testing artifacts).
mutants.out/

# transient cargo-llvm-cov JSON emitted by scripts/coverage-reporting.sh
reporting-cov.json
